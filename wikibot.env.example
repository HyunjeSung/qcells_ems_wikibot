# 위키봇 로컬/Pi 배포용 환경변수 템플릿.
# 실제 값을 채운 파일은 `wikibot.env`로 저장한다 (.gitignore에 포함되어 커밋되지 않음).
# systemd에서는 EnvironmentFile=로 로딩하고(쉘이 아니라 systemd가 직접 KEY=VALUE를 읽음 —
# $ 확장 같은 게 없어 안전), 로컬 dev에서는 `set -a; source wikibot.env; set +a` 후 실행한다.
#
# ⚠️ 로컬 dev(source) 주의: bash의 source는 각 줄을 셸 대입문으로 실행하므로, 값에 `$`가
# 들어있으면(예: scrypt 해시의 `$salt$hash` 구분자) 따옴표 없이 뒀을 때 bash가 그걸 변수
# 확장으로 오해해서 값이 조용히 깨진다(실측: ADMIN_PASSWORD_HASH의 `$odN6...$4df...` 부분이
# 통째로 사라짐, 2026-09-14). `$`가 들어갈 수 있는 값은 반드시 작은따옴표로 감쌀 것:
#   ADMIN_PASSWORD_HASH='scrypt:32768:8:1$abc...$def...'
# systemd EnvironmentFile=은 셸이 아니라서 이 문제가 없지만, 로컬 테스트용으로 항상 따옴표를
# 쓰는 습관을 들이는 게 안전하다.

# --- 화면에 표시되는 버전 배지 (wiki_chat_server.py, /api/whoami) ---
# 릴리스 태그와 맞춰서 수동으로 올린다(예: git tag v1.2.3 찍을 때 이 값도 1.2.3으로).
# 비워두면 "dev"로 표시됨 — 로컬 개발 인스턴스와 정식 배포본을 화면만 보고 구분 가능.
WIKIBOT_VERSION=

# --- 이메일 피드백 (wiki_chat_server.py) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- 관리자 모드 (wiki_chat_server.py --admin, 기본 포트 18011) ---
# 메인 챗봇(8010)과 완전히 같은 UI/기능을 그대로 쓰되, 로그인이 걸리고 사용자가 "✕"로 지운
# 대화도 안 숨겨진다(소프트 삭제라 실제로는 지워지지 않으므로 관리자 화면에서는 계속 보임).
# ADMIN_PASSWORD_HASH는 평문 비밀번호를 직접 넣지 말고 아래로 생성한 해시를 넣는다:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('실제비밀번호'))"
# ADMIN_SECRET_KEY는 세션 쿠키 서명용 — 비워두면 프로세스 재시작마다 랜덤 재생성되어 로그인이 풀린다.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SECRET_KEY=
